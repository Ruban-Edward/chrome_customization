{
    "manifest_version": 3,
    "name": "Custom Startup Page",
    "version": "1.0",
    "description": "A personalized startup page for Chrome.",
    "host_permissions": [
        "https://news.google.com/*",
        "https://api.nasdaq.com/*",
        "https://query2.finance.yahoo.com/*"
    ],
    "chrome_url_overrides": {
        "newtab": "index.html"
    }
}